{
	"name": "bleeps-common",
	"description": "common library used by other modules",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"main": "./lib/index.js",
	"types": "./lib/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		}
	},
	"files": [
		"lib/"
	],
	"devDependencies": {
		"prettier": "^3.9.6",
		"typescript": "~6.0.3"
	},
	"peerDependencies": {
		"viem": "^2.55.10"
	},
	"scripts": {
		"prepare": "pnpm build",
		"dev": "tsc -w --preserveWatchOutput -p tsconfig.json",
		"build": "tsc -p tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	}
}
