// `pnpm start` compiles once before this layout opens. `hardhat node` reads
// artifacts/build-info to build its contract decoder, and `compile:watch` writes
// those files as it starts; both panes launch at the same moment, so without
// that up-front compile the node can read a half-written build-info and die with
//
//   Error: Failed to parse build info: missing field `contracts`
//
// With artifacts already complete, compile:watch's first run is a cache hit that
// writes nothing, and the node reads a consistent tree.
layout {
	pane split_direction="vertical" {
		
	}
	pane split_direction="vertical" {
		pane name="web" command="pnpm"  {
			args "web:dev"
		}
		pane name="svelte-check" command="pnpm"  {
			args "web:check:watch"
		}
		pane name="common lib" command="pnpm"  {
			args "common:dev"
		}
		
	}

	pane split_direction="vertical" {
		pane name="local node" command="pnpm"  {
			args "contracts:node:local" "--port" "8546"
		}
		pane name="purgatory" command="pnpm"  {
			args "contracts:node:purgatory" "--rpc-url" "http://localhost:8546"
		}
		pane name="faucet" command="pnpm"  {
			args "contracts:faucet"
		}
	}

	pane split_direction="vertical" {
		pane name="watch and compile" command="pnpm"  {
			args "contracts:compile:watch"
		}
		pane name="watch and deploy" command="pnpm"  {
			args "contracts:deploy:watch" "localhost" "--ts" "../web/src/lib/deployments.ts"
		}
		pane name="watch and build typescript" command="pnpm"  {
			args "contracts:build:watch"
		}
	}

	pane name="indexing" split_direction="vertical" {
		pane name="graph-node + ipfs + postgres" command="pnpm"  {
			args "externals"
		}
		pane name="subgraph deploy" command="pnpm"  {
			args "subgraph:deploy:local:watch"
		}
		pane name="subgraph schema" command="pnpm"  {
			args "subgraph:schema:watch"
		}
	}
}
