# Values here are safe defaults for local development and are committed.
# Anything secret goes in .env.local (or .env.<mode>.local), which is ignored.

# ----------------------------------------------------------------------------
# subgraph
# ----------------------------------------------------------------------------
SUBGRAPH_NAME=bleeps/bleeps

# graph-node, as started by `pnpm externals`
GRAPH_DEPLOY_ENDPOINT=http://127.0.0.1:8020
GRAPH_NODE_GRAPHQL=127.0.0.1:8000
IPFS_URL=http://127.0.0.1:5001

# for `pnpm subgraph:deploy` against a hosted graph-node. Set in .env.local.
SUBGRAPH_DEPLOY_KEY=

# ----------------------------------------------------------------------------
# booking-service
# ----------------------------------------------------------------------------
# the node the booking service reads transactions from, to confirm a booking was
# actually paid for. Purgatory, so it sees what the app sees.
BOOKING_SERVICE_ETHEREUM_NODE=http://127.0.0.1:8545
DATA_DOG_API_KEY=
