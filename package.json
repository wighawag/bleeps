{
	"name": "bleeps",
	"version": "0.0.1",
	"description": "Bleeps",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.28.1",
	"devDependencies": {
		"cross-var": "^1.1.0",
		"ldenv": "^0.6.0",
		"set-defaults": "^0.0.5",
		"syncpack": "^15.3.2",
		"zellij-launcher": "^0.0.1"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"workerd",
			"sharp"
		],
		"overrides": {
			"utf-8-validate": "-"
		}
	},
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"cleandep": "rm -rf node_modules && pnpm -r exec rm -rf node_modules",
		"---------------------- FORMAT ----------------------": "",
		"format": "pnpm -r format",
		"format:check": "pnpm -r format:check",
		"---------------------- COMMON LIB ----------------------": "compile the common library",
		"common:dev": "pnpm run --filter ./common-lib dev",
		"common:build": "pnpm run --filter ./common-lib build",
		"---------------------- CONTRACTS ----------------------": "compile and deploy smart contracts",
		"contracts:node:local": "ldenv pnpm run --filter ./contracts node:local",
		"contracts:node:purgatory": "pnpm run --filter ./contracts node:purgatory",
		"contracts:faucet": "pnpm run --filter ./contracts faucet",
		"contracts:deploy": "ldenv pnpm run --filter ./contracts deploy @@MODE @@",
		"contracts:deploy:watch": "ldenv pnpm run --filter ./contracts deploy:watch @@MODE @@",
		"contracts:fork:deploy": "ldenv pnpm run --filter ./contracts fork:deploy @@MODE @@",
		"contracts:test": "ldenv pnpm run --filter ./contracts test",
		"contracts:lint": "pnpm --filter ./contracts lint",
		"contracts:execute": "ldenv pnpm run --filter ./contracts execute @@MODE @@",
		"contracts:fork:execute": "ldenv pnpm run --filter ./contracts fork:execute @@MODE @@",
		"contracts:verify": "ldenv pnpm run --filter ./contracts verify @@MODE @@",
		"contracts:verify:bytecode": "pnpm --filter ./contracts verify:bytecode",
		"contracts:compile": "ldenv pnpm --filter ./contracts compile",
		"contracts:compile:watch": "ldenv pnpm --filter ./contracts compile:watch",
		"contracts:build:watch": "ldenv pnpm --filter ./contracts typescript:watch",
		"contracts:build": "ldenv pnpm --filter ./contracts compile ~~ pnpm --filter ./contracts typescript ~~ pnpm --filter ./contracts export @@MODE --ts ../web/src/lib/deployments.ts ~~ @@",
		"contracts:export": "pnpm --filter ./contracts export @@MODE @@",
		"---------------------- WEB ----------------------": "",
		"web:dev": "pnpm --filter ./web dev",
		"web:build": "pnpm --filter ./web build",
		"web:serve": "pnpm --filter ./web serve",
		"web:check": "pnpm --filter ./web check",
		"web:check:watch": "pnpm --filter ./web check:watch",
		"---------------------- SUBGRAPH ----------------------": "",
		"externals": "docker compose -f dev/docker-compose-subgraph.yml up",
		"externals:down": "docker compose -f dev/docker-compose-subgraph.yml down -v",
		"subgraph:generate:codegen": "ldenv pnpm run --filter ./subgraph generate:codegen @@MODE @@",
		"subgraph:deploy": "ldenv pnpm run --filter ./subgraph deploy:build @@MODE @@",
		"subgraph:deploy:local": "ldenv pnpm run --filter ./subgraph deploy:local:build @@MODE @@",
		"subgraph:deploy:local:watch": "ldenv pnpm run --filter ./subgraph deploy:local:watch",
		"subgraph:schema:watch": "ldenv pnpm run --filter ./subgraph schema:watch",
		"---------------------- BOOKING SERVICE ----------------------": "",
		"booking-service:dev": "pnpm run --filter ./booking-service dev",
		"booking-service:deploy": "pnpm run --filter ./booking-service deploy",
		"---------------------- DEPLOY ----------------------": "",
		"build": "ldenv --git -d localhost pnpm common:build ~~ pnpm contracts:build @@MODE ~~ pnpm web:build @@MODE ~~ @@",
		"serve": "pnpm run --filter ./web serve",
		"---------------------- TEST ----------------------": "",
		"test": "pnpm contracts:test",
		"test:unit": "pnpm --filter ./web test:unit -- --run",
		"test:e2e": "pnpm --filter ./web test:e2e",
		"---------------------- WEB USING EXISTING DEPLOYMENT ----------------------": "",
		"zellij-attach": "cross-var zellij-launcher a $npm_package_name-attach-$MODE || cross-var zellij -n dev/zellij-attach.kdl -s $npm_package_name-attach-$MODE",
		"attach": "ldenv -d localhost pnpm contracts:export @@MODE --ts ../web/src/lib/deployments.ts ~~ pnpm run zellij-attach ~~ @@",
		"---------------------- FULL AGAINST AN EXISTING NETWORK WITH LOCAL SERVICES ----------------------": "",
		"zellij-remote-chain": "cross-var zellij-launcher a $npm_package_name-remote-chain-$MODE || cross-var zellij -n dev/zellij-remote-chain.kdl -s $npm_package_name-remote-chain-$MODE",
		"remote-chain": "ldenv -d localhost pnpm run zellij-remote-chain @@",
		"---------------------- RUN FULL LOCAL SETUP ----------------------": "",
		"zellij": "cross-var zellij-launcher a $npm_package_name || cross-var ldenv -d localhost zellij -n dev/zellij.kdl -s $npm_package_name",
		"stop": "cross-var zellij kill-session $npm_package_name",
		"start": "pnpm zellij"
	}
}
