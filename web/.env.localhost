# `//:8545` means "the host this page came from, port 8545", resolved in the
# browser. Written this way so the dev stack works from a phone on the LAN:
# `localhost` in a page opened at 192.168.x.y is the PHONE. An ordinary url
# still works exactly as before; see web/src/lib/core/env/same-host.ts.
PUBLIC_NODE_URL="//:8545"
# Handed to the wallet for wallet_addEthereumChain. Without it the chain has no
# rpcUrl to offer and adding it fails with "Chain ... is not available on your
# wallet". Must be a URL the USER's browser can reach, not one only the app can -
# which is exactly what the notation above gives, and it is resolved before the
# wallet ever sees it (`resolveURLForThisPage` in context/core.ts).
PUBLIC_CHAIN_INFO_NODE_URL="//:8545"
PUBLIC_EXPLORER_BLOCK_INDEX_ENABLED="true"
PUBLIC_USE_BURNER_WALLET=$PUBLIC_NODE_URL
# Who the burner wallet can be, locally. Two well-known addresses, so there is
# someone to switch between; add more here (comma-separated) if you need them.
PUBLIC_IMPERSONATE_ADDRESSES="0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045,0xF78cD306b23031dE9E739A5BcDE61764e82AD5eF"
PUBLIC_FAUCET_LINK="//:34010"
# LEFT ABSOLUTE, and not for want of trying: the notation above only works for a
# value something resolves, and the three that are resolved are the two node urls
# and the faucet link. These two are this app's own and reach no resolver, and an
# unresolved `//:` would fail loudly at the URL parser (which is the notation's
# design). Convert them the day they go through `resolveURLForThisPage` too.
PUBLIC_SUBGRAPH_URL="http://127.0.0.1:8000/subgraphs/name/bleeps/bleeps"
PUBLIC_BOOKING_SERVICE_URL="http://127.0.0.1:8787"
