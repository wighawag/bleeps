{
	"name": "bleeps-contracts",
	"version": "0.1.0",
	"description": "Bleeps smart contracts",
	"private": true,
	"type": "module",
	"exports": {
		"./deploy/*": "./dist/deploy/*",
		"./rocketh/*": "./dist/rocketh/*",
		"./artifacts/*": "./dist/generated/artifacts/*",
		"./abis/*": "./dist/generated/abis/*",
		"./deployments/*": "./deployments/*",
		"./src/*": "./src/*"
	},
	"files": [
		"dist",
		"src",
		"deployments"
	],
	"devDependencies": {
		"@nomicfoundation/hardhat-keystore": "^3.0.12",
		"@nomicfoundation/hardhat-network-helpers": "^3.0.11",
		"@nomicfoundation/hardhat-node-test-runner": "^3.1.0",
		"@nomicfoundation/hardhat-viem": "^3.0.9",
		"@openzeppelin/contracts": "4.3.2",
		"@rocketh/deploy": "^0.19.9",
		"@rocketh/export": "^0.19.11",
		"@rocketh/node": "^0.19.10",
		"@rocketh/read-execute": "^0.19.5",
		"@rocketh/signer": "^0.19.5",
		"@rocketh/verifier": "^0.19.11",
		"@rocketh/viem": "^0.19.5",
		"@types/node": "^26.1.2",
		"as-soon": "^0.1.6",
		"bleeps-common": "workspace:*",
		"cross-var": "^1.1.0",
		"earl": "^2.0.0",
		"ethereum-contracts-test-suite": "^0.2.6",
		"faucet-server": "^0.0.7",
		"hardhat": "^3.12.0",
		"hardhat-deploy": "^2.0.10",
		"ldenv": "^0.6.0",
		"prettier": "^3.9.6",
		"prettier-plugin-solidity": "^2.3.1",
		"purgatory": "^0.0.7",
		"rocketh": "^0.19.9",
		"set-defaults": "^0.0.5",
		"slippy": "^0.3.1",
		"tsx": "^4.23.1",
		"typescript": "~6.0.3",
		"viem": "^2.55.10",
		"wait-on": "^9.1.0",
		"zellij-launcher": "^0.0.1"
	},
	"scripts": {
		"prepare": "set-defaults .vscode && pnpm compile",
		"---------------------- INTERNAL ----------------------": "",
		":deploy+export": "cross-var pnpm hardhat --network $MODE deploy --skip-prompts && cross-var rocketh-export -e $MODE",
		"---------------------- DEV ---------------------- ": "",
		"node:local": "ldenv -d localhost hardhat --network local node --hostname 0.0.0.0",
		"node:purgatory": "purgatory --port 8545 --reset-db --db purgatory.db",
		"faucet": "ldenv -w faucet --no-captcha --port 34010",
		"compile": "hardhat compile",
		"compile:watch": "as-soon -w src pnpm compile",
		"fork:execute": "ldenv tsx @=HARDHAT_FORK=@@MODE @@",
		"fork:deploy": "ldenv pnpm @=HARDHAT_FORK=@@MODE compile --build-profile production ~~  pnpm hardhat --network fork deploy --report-gas-used ~~ @@",
		"deploy:dev": "ldenv -d localhost pnpm :deploy+export @@",
		"deploy:watch": "wait-on ./generated && ldenv -m localhost pnpm as-soon -w generated -w deploy pnpm run deploy:dev @@MODE @@",
		"test": "hardhat test",
		"test:watch": "wait-on ./generated && as-soon -w generated -w test hardhat test --no-compile",
		"typescript:watch": "as-soon -w js pnpm typescript",
		"format:check": "prettier --check .",
		"format": "prettier --write .",
		"lint": "slippy src/**/*.sol",
		"---------------------- VERIFICATION ---------------------- ": "",
		"verify:bytecode": "tsx scripts/verify-deployed-bytecode.ts",
		"---------------------- PRODUCTION ---------------------- ": "",
		"execute": "ldenv -n HARDHAT_NETWORK tsx @@",
		"deploy": "pnpm compile --build-profile production && ldenv hardhat --network @@MODE deploy @@",
		"verify": "ldenv rocketh-verify -e @@MODE @@",
		"export": "ldenv pnpm rocketh-export -e @@MODE @@",
		"typescript": "tsc",
		"---------------------- START ---------------------- ": "",
		"stop": "zellij kill-session $npm_package_name",
		"start": "zellij-launcher a $npm_package_name || zellij -n zellij.kdl -s $npm_package_name"
	}
}
